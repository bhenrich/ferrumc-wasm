#!/usr/bin/env bash
# FerrumC pre-commit: fast checks only (formatting + manifest + generated-file guard).
# Heavy gates (clippy, tests) run in pre-push and CI.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

CHANGED="$(git diff --cached --name-only)"

# Guard: generated files must change only via the generator/fixtures, never by hand.
if echo "$CHANGED" | grep -E '/src/generated/' >/dev/null 2>&1; then
  if ! echo "$CHANGED" | grep -E '^server/crates/ferrumc-proto-gen/|^server/xtask/|^server/fixtures/protocol/' >/dev/null 2>&1; then
    echo "[pre-commit] Generated files changed without a generator/fixture change."
    echo "             Fix the generator or source fixture; do not hand-edit generated files."
    exit 1
  fi
fi

# Only run cargo checks if Rust files are staged.
if echo "$CHANGED" | grep -E '\.rs$|Cargo\.toml$|Cargo\.lock$' >/dev/null 2>&1; then
  cd "$ROOT/server"
  echo "[pre-commit] cargo fmt --all --check"
  cargo fmt --all --check
  echo "[pre-commit] cargo metadata"
  cargo metadata --no-deps >/dev/null
fi

echo "[pre-commit] ok"
